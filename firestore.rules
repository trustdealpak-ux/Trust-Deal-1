rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    match /businesses/{businessId} {
      allow get: if isValidId(businessId);
      allow list: if true;
      allow create, update, delete: if isValidId(businessId);
    }

    match /quotes/{quoteId} {
      allow get: if isValidId(quoteId);
      allow list: if true;
      allow create, update, delete: if isValidId(quoteId);
    }

    match /clients/{clientId} {
      allow get: if isValidId(clientId);
      allow list: if true;
      allow create, update, delete: if isValidId(clientId);
    }

    match /templates/{templateId} {
      allow get: if isValidId(templateId);
      allow list: if true;
      allow create, update, delete: if isValidId(templateId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

